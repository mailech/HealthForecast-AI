# Local development uses SQLite automatically.
# To use PostgreSQL, replace DATABASE_URL with:
# DATABASE_URL=postgresql+psycopg://healthforecast:healthforecast@localhost:5432/healthforecast
DATABASE_URL=sqlite:///./healthforecast.db
JWT_SECRET=healthforecast-demo-secret-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=http://localhost:5173
