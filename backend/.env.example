# This file is only needed for the Docker Compose stack (real Postgres).
# Running locally in a venv? You can skip this entirely — the app defaults
# to a local SQLite file (dev.db) with zero configuration.
ENVIRONMENT=development
DATABASE_URL=postgresql://healthforecast:healthforecast@db:5432/healthforecast
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:3000"]
SEED_ADMIN_EMAIL=admin@healthforecast.ai
SEED_ADMIN_PASSWORD=ChangeMe123!
