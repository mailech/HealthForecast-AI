# HealthForecast AI - Environment Variables
# Do NOT place real secrets in this file.

# Database
DATABASE_URL=postgresql://user:password@db:5432/healthforecast
POSTGRES_USER=placeholder_user
POSTGRES_PASSWORD=placeholder_password
POSTGRES_DB=placeholder_db

# Security
# Run `openssl rand -hex 32` to generate a secure key
SECRET_KEY=placeholder_secret_key_change_me_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default Admin Credentials
# System Administrator initial account setup
ADMIN_EMAIL=admin@healthforecast.org
ADMIN_PASSWORD=placeholder_secure_admin_password
ADMIN_FULL_NAME="System Administrator"

# ML & Data
MODEL_PATH=/app/app/ml/readmission_model.joblib
SCALER_PATH=/app/app/ml/scaler.joblib
ENVIRONMENT=development
