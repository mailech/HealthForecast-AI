# HealthForecast AI - Docker & Environment Configuration Template
# COPY this file to .env before running docker compose

# PostgreSQL Database Configuration
POSTGRES_DB=healthforecast
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_safe_password_change_me

# Backend Service Configuration
SECRET_KEY=super-secret-key-change-in-production-healthforecast-2026-btech
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database URL for Backend Service (using asyncpg for PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres_safe_password_change_me@postgres:5432/healthforecast

# Frontend API Configuration
VITE_API_BASE_URL=/api/v1
